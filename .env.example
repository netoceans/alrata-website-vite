# Canonical production origin (read at build time).
SITE_URL=https://alratadental.com

# Server-only key with Places API (New) enabled and Google Cloud billing configured.
GOOGLE_PLACES_API_KEY=
# Optional exact listing override; otherwise resolved from the clinic name/address.
GOOGLE_PLACE_ID=

# Google Workspace enquiries. Only SMTP_PASS needs filling when using the defaults.
# Generate a 16-letter Google App Password with 2-Step Verification enabled.
# Never use your normal Gmail password. Server-only: no NEXT_PUBLIC_ prefix.
SMTP_USER=dr.alrata@alratadental.com
SMTP_PASS=
INQUIRY_TO=dr.alrata@alratadental.com
# Gmail TLS SMTP host/port are fixed in code (smtp.gmail.com:465).
# Restart the dev server or redeploy after setting these values.
